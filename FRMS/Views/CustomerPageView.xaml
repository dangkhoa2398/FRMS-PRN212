<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.CustomerPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource SectionHeadingStyle}"/>
        <Style x:Key="Subtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}"/>
        <Style x:Key="StatusTag" TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}"/>
        <DataTemplate x:Key="SimpleCard">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusTag}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="{Binding Detail1}" Style="{StaticResource Subtle}" Margin="0,3"/>
                    <TextBlock Text="{Binding Detail2}" Style="{StaticResource Subtle}" Margin="0,3"/>
                    <TextBlock Text="{Binding Detail3}" Style="{StaticResource Subtle}" Margin="0,3"/>
                    <TextBlock Text="{Binding Detail4}" Style="{StaticResource Subtle}" Margin="0,3"/>
                    <Button Content="Reserve this type" Click="ShowReservationReview" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding DataContext.SelectFacilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentPage.IsStorage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ContractCard">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusTag}">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Separator Margin="0,15"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="{Binding FacilityName}" Style="{StaticResource Subtle}" Margin="0,5,12,5"/>
                        <TextBlock Text="{Binding Detail2}" Style="{StaticResource Subtle}" Margin="0,5,12,5"/>
                        <TextBlock Text="{Binding Detail3}" Style="{StaticResource Subtle}" Margin="0,5,12,5"/>
                        <TextBlock Text="{Binding Detail4}" Style="{StaticResource Subtle}" Margin="0,5,12,5"/>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Visit date" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                        <DatePicker SelectedDate="{Binding VisitDate, Mode=TwoWay}" Width="170" Height="34"/>
                        <Button Content="Create Access Visit" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                IsEnabled="{Binding CanCreateVisit}"
                                Command="{Binding DataContext.CreateVisitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InvoiceCard">
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,7,0,0"/>
                        <TextBlock Text="{Binding RelatedStorage}" Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Detail1}" Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Detail2}" Style="{StaticResource Subtle}" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Amount}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" FontSize="25" Margin="0,14,0,0"/>
                        <Button Content="Pay with payOS" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding DataContext.PayInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanPayInvoice}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusTag}">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ReservationCard">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusTag}">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="{Binding Detail1}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Detail2}" Style="{StaticResource Subtle}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding Detail3}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Margin="0,11,0,0"/>
                    <TextBlock Text="{Binding FacilityName}" Style="{StaticResource Subtle}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding HandoverSummary}" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanScheduleHandover}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <WrapPanel>
                            <DatePicker Width="165" Margin="0,0,10,0" AutomationProperties.Name="Handover date"
                                        DisplayDateStart="{Binding HandoverMonthStart, Mode=OneWay}"
                                        DisplayDateEnd="{Binding HandoverMonthEnd, Mode=OneWay}"
                                        SelectedDate="{Binding HandoverDate, Mode=TwoWay}"/>
                            <Button Content="Schedule handover"
                                    Command="{Binding DataContext.ScheduleHandoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding HandoverError}" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AccessVisitCard">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding FacilityName}" Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Detail3}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                    <Border Style="{StaticResource StatusTag}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Detail2}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <DatePicker SelectedDate="{Binding VisitDate, Mode=TwoWay}" Width="170" Height="34"/>
                        <Button Content="Schedule Access Visit" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                IsEnabled="{Binding CanCreateVisit}"
                                Command="{Binding DataContext.CreateVisitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SupportCard">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusTag}">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                    <Button Content="View related contract"
                            HorizontalAlignment="Left" Margin="0,17,0,0"
                            Command="{Binding DataContext.OpenContractCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasContract}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="Refresh" VerticalAlignment="Center" Margin="16,0,0,0"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="28" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ProgressBar Height="3" IsIndeterminate="True">
                <ProgressBar.Style><Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger></Style.Triggers>
                </Style></ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Your account" Style="{StaticResource Heading}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding VisibleRecords}" ItemTemplate="{StaticResource SimpleCard}"/>
                            <WrapPanel>
                                <Button Content="Find storage" CommandParameter="storage" Margin="0,0,8,8" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="My contracts" CommandParameter="contracts" Margin="0,0,8,8" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Invoices" CommandParameter="invoices" Margin="0,0,8,8" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Access visits" CommandParameter="access" Margin="0,0,8,8" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsStorage}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Find available storage" Style="{StaticResource Heading}"/>
                            <TextBlock Text="Choose a facility, then filter its available storage types by size, privacy and rental period." Style="{StaticResource Subtle}" Margin="0,8,0,16"/>
                            <WrapPanel>
                                <StackPanel Width="180" Margin="0,0,12,12">
                                    <TextBlock Text="Facility (required)" Style="{StaticResource Subtle}"/>
                                    <ComboBox ItemsSource="{Binding FacilityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="FacilityId" SelectedValue="{Binding SelectedFacilityId, Mode=TwoWay}" Height="38" Margin="0,7,0,0" ToolTip="Select a facility before searching storage types"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,12">
                                    <TextBlock Text="Privacy" Style="{StaticResource Subtle}"/>
                                    <ComboBox ItemsSource="{Binding StorageModes}" SelectedItem="{Binding StorageMode}"
                                              Height="38" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,12">
                                    <TextBlock Text="Size" Style="{StaticResource Subtle}"/>
                                    <ComboBox ItemsSource="{Binding StorageSizes}" SelectedItem="{Binding StorageSize, Mode=TwoWay}"
                                              Height="38" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,12">
                                    <TextBlock Text="Check-in Month" Style="{StaticResource Subtle}"/>
                                    <DatePicker SelectedDate="{Binding StartMonth, Mode=TwoWay}" Height="38" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,12">
                                    <TextBlock Text="Check-out Month" Style="{StaticResource Subtle}"/>
                                    <DatePicker SelectedDate="{Binding EndMonth, Mode=TwoWay}" Height="38" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,12,12" VerticalAlignment="Bottom">
                                    <Button Content="Find Storage" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,7,0,0"
                                            Command="{Binding DataContext.FindStorageCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </WrapPanel>

                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasSearched}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="Available Storage Types" Style="{StaticResource Heading}" Margin="0,6,0,12"/>
                        <ItemsControl ItemsSource="{Binding VisibleRecords}" ItemTemplate="{StaticResource SimpleCard}"/>
                    </StackPanel>
                    <Border x:Name="ReservationReview" Margin="0,14,0,14">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReservationSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Review reservation" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding ReservationFacilityName}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,6,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Available Unit Type" Style="{StaticResource Subtle}"/>
                                    <ComboBox ItemsSource="{Binding UnitTypes}" DisplayMemberPath="DisplayName" SelectedValuePath="UnitTypeId"
                                              SelectedValue="{Binding SelectedUnitTypeId, Mode=TwoWay}" Height="36"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Start month" Style="{StaticResource Subtle}"/>
                                    <TextBlock Text="{Binding ReservationStartMonth}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="End month" Style="{StaticResource Subtle}"/>
                                    <TextBlock Text="{Binding ReservationEndMonth}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="To change the rental months, update the search and select a storage type again." Style="{StaticResource Subtle}" Margin="0,0,0,12"/>
                            <Button Content="Confirm reservation" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.CreateReservationCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReservations}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsContracts}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsInvoices}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsSupport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsAccess}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style></StackPanel.Style>
                    <Border Style="{StaticResource Panel}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Status" Style="{StaticResource Subtle}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="160"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReservations}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Storage type" Style="{StaticResource Subtle}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding UnitTypeOptions}" SelectedItem="{Binding UnitTypeFilter}" Width="180"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Search" Style="{StaticResource Subtle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" MinHeight="36"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsSupport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Create Support Ticket" Style="{StaticResource Heading}"/>
                            <TextBlock Text="Choose one of your contracts. You do not need to copy an ID."
                                       Style="{StaticResource Subtle}" Margin="0,6,0,12"/>
                            <TextBlock Text="Contract / Storage Unit" Style="{StaticResource Subtle}"/>
                             <ComboBox ItemsSource="{Binding TicketContracts}" DisplayMemberPath="DisplayName" SelectedValuePath="ContractId" SelectedValue="{Binding TicketContractId, Mode=TwoWay}" Height="36" Margin="0,6,0,12"/>
                            <TextBlock Text="Category" Style="{StaticResource Subtle}"/>
                            <ComboBox ItemsSource="{Binding TicketCategories}" SelectedItem="{Binding TicketCategory}" Height="36" Margin="0,6,0,12"/>
                            <TextBlock Text="Description (max 1000 characters)" Style="{StaticResource Subtle}"/>
                            <TextBox Text="{Binding TicketDescription, UpdateSourceTrigger=PropertyChanged}" Height="85" MaxLength="1000" Padding="8"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,12"/>
                            <Button Content="Submit Ticket" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.CreateSupportTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding VisibleRecords}">
                        <ItemsControl.Style><Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource SimpleCard}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReservations}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ReservationCard}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsContracts}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ContractCard}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInvoices}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource InvoiceCard}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSupport}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource SupportCard}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAccess}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource AccessVisitCard}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style></ItemsControl.Style>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
