<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.94*"/>
            <ColumnDefinition Width="1.06*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="24"
                Margin="24" Padding="42">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" Background="{DynamicResource AccentBrush}"
                            CornerRadius="12" Margin="0,0,13,0">
                        <TextBlock Text="F" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FRMS" FontWeight="Bold" FontSize="21"
                                   Foreground="{DynamicResource SidebarActiveTextBrush}"/>
                        <TextBlock Text="SELF-STORAGE PLATFORM" Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SidebarHoverBrush}" CornerRadius="12"
                            HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,25">
                        <TextBlock Text="YOUR SPACE. SIMPLIFIED." FontSize="11"
                                   FontWeight="SemiBold" Foreground="{DynamicResource SidebarForegroundBrush}"/>
                    </Border>
                    <TextBlock Text="Storage made&#10;simple." FontSize="42" LineHeight="52"
                               FontWeight="Bold" Foreground="{DynamicResource SidebarActiveTextBrush}"/>
                    <TextBlock Text="Find the right space, manage reservations and coordinate every visit from one workspace."
                               FontSize="15" Foreground="{DynamicResource SidebarForegroundBrush}"
                               TextWrapping="Wrap" LineHeight="23" Margin="0,22,0,0"/>
                    <Border Height="1" Background="{DynamicResource SidebarHoverBrush}" Margin="0,34,0,28"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SidebarHoverBrush}">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource SidebarActiveTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Spaces, visits &amp; support" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarActiveTextBrush}"/>
                            <TextBlock Text="Everything you need, in one place" FontSize="11"
                                       Foreground="{DynamicResource SidebarMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="FRMS  •  PRN212" Foreground="{DynamicResource SidebarMutedBrush}"
                           FontSize="11"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Button Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"
                    Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,35,40,0" Padding="16,9" ToolTip="Switch color mode"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="20" Width="420" Padding="37"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="5"
                                      Color="#101F3F" Opacity="0.09"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Welcome back" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Sign in to access your storage workspace."
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                               TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock Text="Account type" FontWeight="SemiBold" Margin="0,29,0,8"/>
                    <ComboBox ItemsSource="{Binding LoginModes}" SelectedItem="{Binding LoginMode}" Height="42"/>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoginMode}" Value="Customer">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Phone number" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoginMode}" Value="Staff / Manager">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Employee email" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <TextBox Text="{Binding EmployeeEmail, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
                    </StackPanel>
                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <PasswordBox x:Name="PasswordInput" Height="42"/>
                    <TextBlock Text="{Binding LoginError}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button Content="Sign in" Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=PasswordInput}"
                            Height="44" Margin="0,23,0,0"/>
                    <TextBlock Text="Secure access for customers and facility teams"
                               TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" Margin="0,19,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
