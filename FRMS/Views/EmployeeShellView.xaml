<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.EmployeeShellView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Menu" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="7,3"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <TextBlock Text="FRMS  |  Facility Operations" FontSize="20" FontWeight="Bold"
                           Foreground="#1D4ED8" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmployeeWorkspace.DisplayName}" Foreground="#334155" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding EmployeeRole}" Foreground="#475569" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#0F172A">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="Log out" Style="{StaticResource Menu}"
                            Command="{Binding LogoutCommand}" Margin="7,8,7,18"/>
                    <StackPanel Margin="0,18,0,0">
                        <Button Content="Home" Style="{StaticResource Menu}"
                                Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="home"/>
                        <Button Content="Task" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="task">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Reservations" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="reservations">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Customer Contracts" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="storage">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Storage Unit Control" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="storage">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Customer Check-in / Out" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="access">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Visit Oversight" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="access">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Resolve Tickets" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="support">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Ticket Assignment" Command="{Binding EmployeeWorkspace.NavigateCommand}" CommandParameter="support">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Menu}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl x:Name="EmployeePageHost" Grid.Column="1" Margin="24"/>
        </Grid>
    </Grid>
</UserControl>
