<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.CustomerShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RouteMatchConverter}">
                            <Binding Path="CurrentPage.Route"/>
                            <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{DynamicResource AccentBrush}"
                            CornerRadius="11" Margin="0,0,13,0">
                        <TextBlock Text="F" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FRMS" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Self-storage workspace" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource GhostButtonStyle}" Padding="14,9"
                            ToolTip="Switch between light and dark appearance" Margin="0,0,19,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,13,0">
                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Text="Customer account" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" TextAlignment="Right"/>
                    </StackPanel>
                    <Border Background="{DynamicResource AccentSoftBrush}" Padding="11,7" CornerRadius="15">
                        <TextBlock Text="CUSTOMER" Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SidebarBrush}" Grid.Column="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18">
                        <Border Height="1" Background="{DynamicResource SidebarHoverBrush}" Margin="22,10,22,15"/>
                        <Button Style="{StaticResource MenuButton}" Command="{Binding LogoutCommand}" >
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AC;" FontSize="16"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Width="29" VerticalAlignment="Center"/>
        <TextBlock Text="Sign out" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
</Button>
                    </StackPanel>
                    <StackPanel Margin="0,24,0,0">
                        <TextBlock Text="WORKSPACE" Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontWeight="SemiBold" FontSize="10" Margin="27,0,0,16"/>
                        <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="home" >
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Width="29" VerticalAlignment="Center"/>
        <TextBlock Text="Overview" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
</Button>
                        <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="storage" >
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="16"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Width="29" VerticalAlignment="Center"/>
        <TextBlock Text="Find storage" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
</Button>
                        <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="reservations" >
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="16"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Width="29" VerticalAlignment="Center"/>
        <TextBlock Text="Reservations" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
</Button>
                        <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="contracts" >
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="16"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Width="29" VerticalAlignment="Center"/>
        <TextBlock Text="Contracts" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
</Button>
                        <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="invoices" >
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;" FontSize="16"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Width="29" VerticalAlignment="Center"/>
        <TextBlock Text="Invoices" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
</Button>
                        <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="support" >
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F2;" FontSize="16"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Width="29" VerticalAlignment="Center"/>
        <TextBlock Text="Support tickets" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
</Button>
                        <Border Margin="23,26,23,0" Padding="16,14" Background="{DynamicResource SidebarHoverBrush}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="NEED A HAND?" Foreground="{DynamicResource SidebarActiveTextBrush}"
                                           FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Manage your rentals and support requests from one place."
                                           Foreground="{DynamicResource SidebarForegroundBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="30,26,30,18"/>
        </Grid>
    </Grid>
</UserControl>
