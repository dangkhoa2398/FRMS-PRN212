<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.CustomerShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <TextBlock Text="FRMS  |  Self-Storage Rental" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CustomerName}" Foreground="#334155" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CUSTOMER" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0F172A">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="Log out" Command="{Binding LogoutCommand}"
                            Style="{StaticResource MenuButton}" Margin="7,8,7,18"/>
                    <StackPanel Margin="0,18,0,0">
                        <Button Content="Home" Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="home"/>
                        <Button Content="Find Storage" Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="storage"/>
                        <Button Content="My Reservations" Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="reservations"/>
                        <Button Content="My Contracts" Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="contracts"/>
                        <Button Content="Ra / Vào" Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="access"/>
                        <Button Content="Invoices" Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="invoices"/>
                        <Button Content="Support" Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="support"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24"/>
        </Grid>
    </Grid>
</UserControl>
