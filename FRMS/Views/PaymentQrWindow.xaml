<Window x:Class="FRMS.PRN212.WpfConnection.Views.PaymentQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pay with payOS" Width="465" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} VND}" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="QrHint" Text="Scan with your bank app." Margin="0,12,0,4"/>
        <Image x:Name="QrImage" Width="288" Height="288" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="VietQR payment code"/>
        <TextBlock x:Name="ExpiryText" Text="{Binding ExpiresAt, StringFormat='Expires {0:HH:mm dd/MM/yyyy} (GMT+7)'}"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock x:Name="ExpiredHint" Text="Checkout expired. You can still check its status."
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="CheckoutButton" Content="Open payOS" Click="OpenCheckout" Margin="0,0,8,8"/>
            <Button x:Name="CheckButton" Content="Check status" Click="CheckPayment" Margin="0,0,8,8"/>
            <Button x:Name="RetryButton" Content="Retry payment" Click="RetryPayment" Margin="0,0,8,8"/>
            <Button Content="Close" IsCancel="True" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock x:Name="CheckoutError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
