<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.EmployeePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding EmployeeWorkspace.Title}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding EmployeeWorkspace.Description}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0"/>
            </StackPanel>
            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding EmployeeWorkspace.RefreshCommand}" Padding="16,10"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource AccentBrush}">
                <ProgressBar.Style><Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style></ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding EmployeeWorkspace.Message}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="24">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Employee Information" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                <TextBlock Text="Full name" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding EmployeeWorkspace.DisplayName}" FontWeight="SemiBold" FontSize="20" Margin="0,5,0,18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,18,16">
                        <TextBlock Text="Email" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Email}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,16">
                        <TextBlock Text="Phone" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Phone}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Role" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Role}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Assigned facility" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.FacilityName}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.FacilityId}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="175"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Status" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox Height="36" ItemsSource="{Binding EmployeeWorkspace.StatusOptions}"
                              SelectedItem="{Binding EmployeeWorkspace.SelectedStatus}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmployeeWorkspace.ShowCategoryFilter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Storage Type / Category" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox Height="36" ItemsSource="{Binding EmployeeWorkspace.CategoryOptions}"
                              SelectedItem="{Binding EmployeeWorkspace.SelectedCategory}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Search" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Height="36" Padding="10,7" Text="{Binding EmployeeWorkspace.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmployeeWorkspace.ShowDateFilter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Date filter (optional)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <DatePicker Height="36" SelectedDate="{Binding EmployeeWorkspace.SelectedDate, Mode=TwoWay}"/>
                    <Button Content="Clear date / All dates" Padding="8,4" Margin="0,5,0,0"
                            Command="{Binding EmployeeWorkspace.ClearWorkDateFilterCommand}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding EmployeeWorkspace.Route}" Value="storage"/>
                                        <Condition Binding="{Binding EmployeeWorkspace.IsManager}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Create a physical storage unit" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Choose its storage type, enter a unique code and describe where the unit is located." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Width="245" Margin="0,0,12,10">
                            <TextBlock Text="Storage type (required)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <ComboBox Height="34" ToolTip="Select a named storage type, e.g. Small Private" ItemsSource="{Binding EmployeeWorkspace.AvailableUnitTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EmployeeWorkspace.NewUnitTypeId, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,10">
                            <TextBlock Text="Unit code (required)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox Height="34" Padding="7" ToolTip="Unique physical unit code, e.g. A-103" Text="{Binding EmployeeWorkspace.NewUnitCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="265" Margin="0,0,12,10">
                            <TextBlock Text="Location (optional)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox Height="34" Padding="7" ToolTip="Location of the unit, e.g. Floor 1 - Row A" Text="{Binding EmployeeWorkspace.NewUnitLocation, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Create Storage Unit" Padding="12,7" Height="34" Margin="0,20,0,10" Command="{Binding EmployeeWorkspace.CreateStorageUnitCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding EmployeeWorkspace.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="9,17">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource StatusBackgroundBrush}" CornerRadius="12" Padding="10,5">
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail1}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                                    <TextBlock Text="{Binding Detail2}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="task"/>
                                                            <Condition Binding="{Binding IsInspection}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Inspection – check the unit condition. Claim it before completing if it is not yet assigned." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                        <TextBlock Text="Condition note (required to complete)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding InspectionNote, UpdateSourceTrigger=PropertyChanged}" Height="56" AcceptsReturn="True" TextWrapping="Wrap" Padding="7" VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Claim inspection" Padding="12,7" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.EmployeeWorkspace.ClaimInspectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="IN_PROGRESS">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="COMPLETED">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Complete inspection" Padding="12,7"
                                                    Command="{Binding DataContext.EmployeeWorkspace.CompleteInspectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="IN_PROGRESS">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button IsEnabled="{Binding CanCheckIn}" Content="Check in" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.CheckInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="access"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <Button IsEnabled="{Binding CanCheckOut}" Content="Check out" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.CheckOutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="access"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <TextBox Width="210" Height="32" Padding="6" Margin="0,0,8,0" ToolTip="For reservation handover enter Storage Unit ID; for return enter actual date yyyy-MM-dd"
                                                 Text="{Binding DataContext.EmployeeWorkspace.ActionInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="task"/><Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding WorkType}" Value="RESERVATION_VISIT"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="task"/><Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding WorkType}" Value="RETURN_VISIT"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBox.Style>
                                        </TextBox>
                                        <Button Content="Auto Assign Unit" Padding="10,6" Margin="0,0,8,0" Command="{Binding DataContext.EmployeeWorkspace.AssignHandoverUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="reservations"/><Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button IsEnabled="{Binding CanCompleteHandover}" Content="Complete handover" Padding="10,6" Margin="0,0,8,0" Command="{Binding DataContext.EmployeeWorkspace.CompleteHandoverCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="task"/><Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding WorkType}" Value="RESERVATION_VISIT"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button IsEnabled="{Binding CanConfirmReturn}" Content="Confirm return" Padding="10,6" Margin="0,0,8,0" Command="{Binding DataContext.EmployeeWorkspace.ConfirmReturnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="task"/><Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding WorkType}" Value="RETURN_VISIT"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <TextBox Width="220" Height="32" Padding="6" Margin="0,0,8,0"
                                                 Text="{Binding DataContext.EmployeeWorkspace.ActionNote, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBox.Style>
                                        </TextBox>
                                        <Button Content="Complete ticket" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.CompleteTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <ComboBox Width="220" Height="32" Margin="0,0,8,0" ToolTip="Select Facility Staff" ItemsSource="{Binding DataContext.EmployeeWorkspace.FacilityStaff, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DataContext.EmployeeWorkspace.SelectedStaffId, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                                            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></ComboBox.Style>
                                        </ComboBox>
                                        <Button Content="Assign ticket" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.AssignTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <ComboBox Width="145" Height="32" Margin="0,0,8,0"
                                                  ItemsSource="{Binding DataContext.EmployeeWorkspace.StorageStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.EmployeeWorkspace.StorageStatus, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="storage"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></ComboBox.Style>
                                        </ComboBox>
                                        <Button Content="Update status" Padding="10,6"
                                                Command="{Binding DataContext.EmployeeWorkspace.ChangeStorageStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="storage"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
