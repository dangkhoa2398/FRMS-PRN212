<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.EmployeePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding EmployeeWorkspace.Title}" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="{Binding EmployeeWorkspace.Description}" Foreground="#64748B" Margin="0,7,0,0"/>
            </StackPanel>
            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding EmployeeWorkspace.RefreshCommand}" Padding="16,10"
                    Background="#1D4ED8" Foreground="White"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <ProgressBar IsIndeterminate="True" Height="3">
                <ProgressBar.Style><Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style></ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding EmployeeWorkspace.Message}" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="24">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Employee Information" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,20"/>
                <TextBlock Text="Full name" Foreground="#64748B"/>
                <TextBlock Text="{Binding EmployeeWorkspace.DisplayName}" FontWeight="SemiBold" FontSize="20" Margin="0,5,0,18" Foreground="#0F172A"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,18,16">
                        <TextBlock Text="Email" Foreground="#64748B"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Email}" FontSize="15" Foreground="#0F172A" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,16">
                        <TextBlock Text="Phone" Foreground="#64748B"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Phone}" FontSize="15" Foreground="#0F172A" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Role" Foreground="#64748B"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Role}" FontSize="15" Foreground="#0F172A" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Assigned facility" Foreground="#64748B"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.FacilityName}" FontSize="15" Foreground="#0F172A" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.FacilityId}" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="175"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Status" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox Height="36" ItemsSource="{Binding EmployeeWorkspace.StatusOptions}"
                              SelectedItem="{Binding EmployeeWorkspace.SelectedStatus}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Type / Category" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox Height="36" ItemsSource="{Binding EmployeeWorkspace.CategoryOptions}"
                              SelectedItem="{Binding EmployeeWorkspace.SelectedCategory}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Search" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox Height="36" Padding="10,7" Text="{Binding EmployeeWorkspace.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmployeeWorkspace.ShowDateFilter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Task / Visit date" Foreground="#64748B" Margin="0,0,0,6"/>
                    <DatePicker Height="36" SelectedDate="{Binding EmployeeWorkspace.SelectedDate, Mode=TwoWay}"
                                SelectedDateChanged="WorkDateChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding EmployeeWorkspace.Route}" Value="storage"/>
                                        <Condition Binding="{Binding EmployeeWorkspace.IsManager}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBox Width="210" Height="34" Padding="7" Margin="0,0,8,0" ToolTip="Unit Type ID" Text="{Binding EmployeeWorkspace.NewUnitTypeId, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="150" Height="34" Padding="7" Margin="0,0,8,0" ToolTip="Unit Code" Text="{Binding EmployeeWorkspace.NewUnitCode, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="220" Height="34" Padding="7" Margin="0,0,8,0" ToolTip="Location information" Text="{Binding EmployeeWorkspace.NewUnitLocation, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Create Storage Unit" Padding="12,7" Command="{Binding EmployeeWorkspace.CreateStorageUnitCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding EmployeeWorkspace.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="9,17">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#0F172A" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#64748B" Margin="0,7,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="10,5">
                                            <TextBlock Text="{Binding Status}" Foreground="#0369A1"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail1}" Foreground="#475569" Margin="0,12,0,0"/>
                                    <TextBlock Text="{Binding Detail2}" Foreground="#475569" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#334155" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Check in" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.CheckInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="access"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <Button Content="Check out" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.CheckOutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="access"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <TextBox Width="220" Height="32" Padding="6" Margin="0,0,8,0"
                                                 Text="{Binding DataContext.EmployeeWorkspace.ActionNote, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style><Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBox.Style>
                                        </TextBox>
                                        <Button Content="Complete ticket" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.CompleteTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsStaff, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <TextBox Width="220" Height="32" Padding="6" Margin="0,0,8,0"
                                                 Text="{Binding DataContext.EmployeeWorkspace.ActionInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style><Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBox.Style>
                                        </TextBox>
                                        <Button Content="Assign ticket" Padding="10,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EmployeeWorkspace.AssignTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="support"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <ComboBox Width="145" Height="32" Margin="0,0,8,0"
                                                  ItemsSource="{Binding DataContext.EmployeeWorkspace.StorageStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.EmployeeWorkspace.StorageStatus, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox.Style><Style TargetType="ComboBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="storage"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></ComboBox.Style>
                                        </ComboBox>
                                        <Button Content="Update status" Padding="10,6"
                                                Command="{Binding DataContext.EmployeeWorkspace.ChangeStorageStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.Route, RelativeSource={RelativeSource AncestorType=Window}}" Value="storage"/>
                                                            <Condition Binding="{Binding DataContext.EmployeeWorkspace.IsManager, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
