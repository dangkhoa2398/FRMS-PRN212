<UserControl x:Class="FRMS.PRN212.WpfConnection.Views.EmployeePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EmployeeWorkDetails.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="Refresh" VerticalAlignment="Center" Margin="16,0,0,0"
                    Style="{StaticResource GhostButtonStyle}" Command="{Binding EmployeeWorkspace.RefreshCommand}"/>
            <StackPanel>
                <TextBlock Text="{Binding EmployeeWorkspace.Title}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding EmployeeWorkspace.Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource AccentBrush}">
                <ProgressBar.Style><Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style></ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding EmployeeWorkspace.Message}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="24">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Employee Information" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                <TextBlock Text="Full name" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding EmployeeWorkspace.DisplayName}" FontWeight="SemiBold" FontSize="20" Margin="0,5,0,18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,18,16">
                        <TextBlock Text="Email" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Email}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,16">
                        <TextBlock Text="Phone" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Phone}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Role" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.Role}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Assigned facility" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmployeeWorkspace.FacilityName}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel>
                    <StackPanel Width="140" Margin="0,0,12,8">
                        <TextBlock Text="Status" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox Height="36" ItemsSource="{Binding EmployeeWorkspace.StatusOptions}"
                                  SelectedItem="{Binding EmployeeWorkspace.SelectedStatus}"/>
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,12,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EmployeeWorkspace.ShowCategoryFilter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Storage Type / Category" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox Height="36" ItemsSource="{Binding EmployeeWorkspace.CategoryOptions}"
                                  SelectedItem="{Binding EmployeeWorkspace.SelectedCategory}"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="Search" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Height="36" Padding="10,7" Text="{Binding EmployeeWorkspace.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EmployeeWorkspace.ShowDateFilter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Scheduled date" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker Width="125" Height="36" SelectedDate="{Binding EmployeeWorkspace.SelectedDate, Mode=TwoWay}"/>
                            <Button Content="Clear date" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="8,0,0,0"
                                    Command="{Binding EmployeeWorkspace.ClearWorkDateFilterCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmployeeWorkspace.ShowTaskPeriods}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Task period" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="160" ItemsSource="{Binding EmployeeWorkspace.TaskPeriods}"
                              SelectedItem="{Binding EmployeeWorkspace.TaskPeriod}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding EmployeeWorkspace.Route}" Value="storage"/>
                                        <Condition Binding="{Binding EmployeeWorkspace.IsManager}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Create a physical storage unit" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Choose its storage type, enter a unique code and describe where the unit is located." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Width="245" Margin="0,0,12,10">
                            <TextBlock Text="Storage type (required)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <ComboBox Height="34" ToolTip="Select a named storage type, e.g. Small Private" ItemsSource="{Binding EmployeeWorkspace.AvailableUnitTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EmployeeWorkspace.NewUnitTypeId, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,10">
                            <TextBlock Text="Unit code (required)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox Height="34" Padding="7" ToolTip="Unique physical unit code, e.g. A-103" Text="{Binding EmployeeWorkspace.NewUnitCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="265" Margin="0,0,12,10">
                            <TextBlock Text="Location (optional)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox Height="34" Padding="7" ToolTip="Location of the unit, e.g. Floor 1 - Row A" Text="{Binding EmployeeWorkspace.NewUnitLocation, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Create Storage Unit" Padding="12,7" Height="34" Margin="0,20,0,10" Command="{Binding EmployeeWorkspace.CreateStorageUnitCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmployeeWorkspace.IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding EmployeeWorkspace.Items}"
                          SelectedItem="{Binding EmployeeWorkspace.SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource WorkTableStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Record" Binding="{Binding Title}" Width="2*" MinWidth="110"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Subtitle}" Width="3*" MinWidth="120"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="*" MinWidth="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="95"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ListBox ItemsSource="{Binding EmployeeWorkspace.Items}"
                         SelectedItem="{Binding EmployeeWorkspace.SelectedItem, Mode=TwoWay}"
                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmployeeWorkspace.IsManager}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8">
                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeStyle}" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusForegroundBrush}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DateValue}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding EmployeeWorkspace.SelectedItem}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource EmployeeWorkDetails}"/>
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Margin="8,16" Text="Select a record to view its details and actions."
                                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
