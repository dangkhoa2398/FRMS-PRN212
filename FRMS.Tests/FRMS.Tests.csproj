<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile platform-independent production logic, without requiring a Windows WPF host. -->
    <Compile Include="../FRMS/Services/CustomerApiService.cs" Link="Production/CustomerApiService.cs" />
    <Compile Include="../FRMS/ViewModels/CustomerPageViewModel.cs" Link="Production/CustomerPageViewModel.cs" />
  </ItemGroup>
</Project>
