<Window x:Class="FRMS.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FRMS — WPF / REST API" Height="525" Width="780"
        MinHeight="430" MinWidth="600" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="FRMS — Kiểm tra kết nối Backend"
               FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
    <DockPanel Grid.Row="1" Margin="0,0,0,14">
      <TextBlock Text="API base URL" Width="110" VerticalAlignment="Center" />
      <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
               Padding="9,6" FontSize="14" />
    </DockPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <Button Content="Kiểm tra /health" Command="{Binding CheckHealthCommand}"
                Padding="15,9" Margin="0,0,10,0" />
        <Button Content="GET /api/v1/facilities" Command="{Binding LoadFacilitiesCommand}"
                Padding="15,9" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
    <TextBox Grid.Row="3" Text="{Binding ResponseBody}" FontFamily="Consolas"
             FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             IsReadOnly="True" Padding="12" />
  </Grid>
</Window>
