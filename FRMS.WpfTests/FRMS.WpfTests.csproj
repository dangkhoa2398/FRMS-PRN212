<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FRMS/FRMS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Inspect theme XML in CI without depending on an interactive WPF Application. -->
    <None Include="../FRMS/Themes/Light.xaml" Link="TestAssets/Light.xaml" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../FRMS/Themes/Dark.xaml" Link="TestAssets/Dark.xaml" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../FRMS/Themes/Controls.xaml" Link="TestAssets/Controls.xaml" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
